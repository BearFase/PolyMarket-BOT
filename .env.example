# Polymarket US API credentials
# Create and revoke these at https://polymarket.us/developer
# This platform authenticates against Polymarket US (api.polymarket.us,
# gateway.polymarket.us), not the international polymarket.com stack. Keys
# from polymarket.com will not work here.
# The developer portal calls them Key ID and Secret Key. The Secret Key is
# shown once at creation; if it is lost, revoke the key and create another.
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here

# The Odds API key (free tier at https://the-odds-api.com)
# Free plan: 500 requests/month — four 6-hourly scans stay well within budget
ODDS_API_KEY=your_odds_api_key_here

# Research-only Telegram morning report
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_MORNING_BRIEF_ENABLED=true
TELEGRAM_MORNING_HOUR_LOCAL=7
TELEGRAM_PREGAME_ALERTS_ENABLED=true
TELEGRAM_PREGAME_MINUTES_BEFORE=60
TELEGRAM_FINAL_ALERTS_ENABLED=true
TELEGRAM_SYSTEM_WARNINGS_ENABLED=true
TELEGRAM_WARNING_COOLDOWN_MINUTES=180
TELEGRAM_TIMEZONE=America/Los_Angeles

# Minimum risk amount shown on the Big Money/live tape
BIG_MONEY_MIN_DISPLAY_USD=5
